# Copy to .env and fill in what you use. All settings are optional except at
# least one provider key.
#
# Provider selection: auto (prefer NIM, then OpenRouter), nim, or openrouter.
ASSISTANT_PROVIDER=auto

# At least one of these. NIM is preferred when both are set.
ASSISTANT_NVIDIA_API_KEY=nvapi-...
ASSISTANT_OPENROUTER_API_KEY=sk-or-...

# Optional endpoint overrides (proxies, self-hosted NIM, local test servers).
# ASSISTANT_NIM_BASE_URL=
# ASSISTANT_OPENROUTER_BASE_URL=

# Server. Bind to 0.0.0.0 so the Android app (and other devices on your LAN)
# can reach it. Use 127.0.0.1 if you only ever access it from this machine.
ASSISTANT_HOST=0.0.0.0
ASSISTANT_PORT=8848

# Optional password protection. Leave empty for a loopback-only, no-login setup.
# ASSISTANT_PASSWORD=
# Set to true when serving over HTTPS through a reverse proxy.
# ASSISTANT_COOKIE_SECURE=false

# Database encryption. Sensitive chat content, notes, tasks, upload metadata,
# and stored API keys are encrypted at rest. Leave these empty to generate a key
# at ~/.config/nexus/secret.key (outside this repository). Back that key up;
# without it, an encrypted database cannot be decrypted.
# ASSISTANT_ENCRYPTION_KEY=
# ASSISTANT_SECRET_KEY_FILE=

# Files and sandbox paths. These defaults are created by
# scripts/setup-sandbox-user.sh.
# ASSISTANT_HOME=/home/nexus
# ASSISTANT_DATA_DIR=./data
# ASSISTANT_SANDBOX_ACCOUNT=sandbox
# ASSISTANT_SANDBOX_IMAGE=localhost/nexus-code-sandbox:latest
# ASSISTANT_SANDBOX_PODMAN_WRAPPER=/usr/local/bin/nexus-sandbox-podman
# ASSISTANT_SANDBOX_MEMORY=768m
# ASSISTANT_SANDBOX_CPUS=1.0
# ASSISTANT_SANDBOX_TIMEOUT=90
# ASSISTANT_SANDBOX_NETWORK=true
# ASSISTANT_SANDBOX_DNS=1.1.1.1,9.9.9.9

# Search: the app talks to a SearXNG instance over HTTP.
ASSISTANT_SEARXNG_URL=http://127.0.0.1:8888

# Model behavior.
# ASSISTANT_TEMPERATURE=0.6
# ASSISTANT_MAX_TOKENS=8192
# ASSISTANT_MAX_TOOL_STEPS=10
# Total tool output kept in the live prompt per turn; older results are
# replaced with one-line stubs beyond this.
# ASSISTANT_MAX_TOOL_OUTPUT_CHARS=80000
# ASSISTANT_TOOL_RESULT_KEEP_RECENT=3

# Provider retry policy. 429s and temporary outages retry with jittered
# exponential backoff, and provider Retry-After hints are honored up to the
# retry-after cap. Timed-out attempts stop after a smaller budget.
# ASSISTANT_RETRY_MAX_ATTEMPTS=10
# ASSISTANT_RETRY_BASE_DELAY=2.0
# ASSISTANT_RETRY_MAX_DELAY=10.0
# ASSISTANT_RETRY_AFTER_MAX=900.0
# ASSISTANT_RETRY_JITTER=0.2
# ASSISTANT_RETRY_TIMEOUT_ATTEMPTS=3

# Native visual reading. Images and PDF pages opened with read_file are sent to
# vision-capable models as image parts. Set VISION_ENABLED=false for text-only.
# ASSISTANT_VISION_ENABLED=true
# ASSISTANT_VISION_MAX_PAGES=4
# ASSISTANT_VISION_MAX_DIMENSION=1600
# ASSISTANT_VISION_MAX_TOTAL_MB=6
# ASSISTANT_VISION_MAX_FILE_MB=100
# ASSISTANT_VISION_MAX_IMAGES_PER_TURN=8
