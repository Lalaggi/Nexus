{
  "appId": "com.elliewells.nexus",
  "appName": "Nexus",
  "webDir": "dist",
  "server": {
    "cleartext": true,
    "androidScheme": "http"
  },
  "android": {
    "allowMixedContent": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 600,
      "backgroundColor": "#2E1F52",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "StatusBar": {
      "backgroundColor": "#141218",
      "style": "DARK",
      "webViewStyle": "DARK_CONTENT"
    },
    "Keyboard": {
      "resize": "body",
      "style": "DARK"
    }
  }
}
